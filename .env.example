# Copy to .env.local for local dev; set the same keys as Environment
# Variables in the Vercel project for a deployment.

# The CrewFinding API, /v1 included. Defaults to http://localhost:4000/v1 when
# unset, which is ONLY correct for local dev — a deployed app must point at
# https://api.crewfinding.com/v1, and the API's FRONTEND_URL (its CORS origin)
# must be this site's origin.
VITE_API_URL=http://localhost:4000/v1

# Live updates (SSE). Deployed: https://stream.crewfinding.com/v1 — Vercel cuts
# long responses, so streams come from the Cloud Run stream host (its
# FRONTEND_URL must be this site's origin too). Unset: the API serves them.
VITE_STREAM_API_URL=

# Enables the card form on /billing (Stripe Payment Element, card only).
# Publishable key only — never the secret. Sandbox (pk_test_…) until launch.
VITE_STRIPE_PUBLISHABLE_KEY=
